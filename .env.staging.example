# Copia este archivo a `.env.staging` y rellena los valores reales.
# NUNCA comitees `.env.staging` (está en .gitignore).

# Obligatoria: clave maestra (64 hex chars = 256 bits) para cifrar PHI en reposo
# (crypto.rs::validate_master_key falla rápido —fail-closed— si falta, es corta o
# conserva un marcador de placeholder). Genera una real con:
#   openssl rand -hex 32
DMART_MASTER_KEY=

# Obligatoria: secreto de firma JWT (64 hex chars). Sin ella el servidor no
# arranca, porque un secreto predecible permite forjar access tokens.
#   openssl rand -hex 32
JWT_SECRET=

# Contraseña del admin inicial. Vacía => se genera una temporal (se imprime 1 vez).
DMART_ADMIN_PASSWORD=

# Costes Argon2id (OWASP: M=19456, t=3, p=1 para login interactivo)
DMART_ARGON2_M_COST=19456
DMART_ARGON2_T_COST=3
DMART_ARGON2_P_COST=1

# ─── HL7/MLLP bedside (SPEC-052 / auditoría H3) ──────────
# MLLP es texto plano sobre TCP. En producción el listener NO arranca sin mTLS
# (DMART_ENV=production + sin mTLS => arranque abortado), de modo que ni el
# secreto de autenticación ni las constantes vitales viajan en claro.
#   DMART_MLLP_BIND                  → interfaz. Default 127.0.0.1 (loopback).
#   DMART_MLLP_CERT_FILE/KEY_FILE    → certificado y clave del servidor.
#   DMART_MLLP_CA_FILE               → CA que firma los certificados de monitor.
#   DMART_MLLP_CLIENT_IDS            → pins: <sha256-cert>=<MSH.3>,CSV. La
#                                     identidad del transporte es el certificado,
#                                     así que un monitor no puede declarar el
#                                     MSH.3 de otro.
# TLS 1.3 + AES-256-GCM exclusivamente; el certificado de cliente es obligatorio.
DMART_HL7_PORT=2575
DMART_MLLP_BIND=127.0.0.1:2575
DMART_MLLP_CERT_FILE=
DMART_MLLP_KEY_FILE=
DMART_MLLP_CA_FILE=
DMART_MLLP_CLIENT_IDS=
DMART_MLLP_MAX_CONNECTIONS=64
DMART_MLLP_MAX_CONNECTIONS_PER_IP=8
DMART_MLLP_READ_TIMEOUT_SECS=30
DMART_MLLP_WRITE_TIMEOUT_SECS=10
