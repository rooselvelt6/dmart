# =============================================================================
# dMart UCI Server - Environment Variables
# =============================================================================
# Copy this file to .env and adjust values for your environment

# Server
DMART_PORT=3000
DMART_HOST=0.0.0.0

# Database
DMART_DB_PATH=./data/dmart.db

# Frontend static files
DMART_DIST_PATH=./dist

# Cache (Valkey/Redis)
DMART_VALKEY_URL=redis://127.0.0.1:6379

# Logging
RUST_LOG=dmart_server=info,tower_http=info

# Security (change in production!)
JWT_SECRET=change-me-to-a-random-64-char-string

# Institution (optional - set via admin UI)
INSTITUTION_NAME=
