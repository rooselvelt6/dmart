# =============================================================================
# dMart UCI Server - Environment Variables
# =============================================================================
# Copy this file to .env and adjust values for your environment

# Server
DMART_PORT=3000
DMART_HOST=0.0.0.0

# Database
DMART_DB_PATH=./data/dmart.db

# Frontend static files
DMART_DIST_PATH=./dist

# Cache (Valkey/Redis)
DMART_VALKEY_URL=redis://127.0.0.1:6379

# Logging
RUST_LOG=dmart_server=info,tower_http=info

# Security (change in production!)
# Generate with: openssl rand -hex 32
DMART_MASTER_KEY=change-this-to-a-random-32-char-secret
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRY_HOURS=1

# Admin initial password (first run only). Leave empty to generate a random
# one that is printed once in the server logs.
DMART_ADMIN_PASSWORD=

# Argon2id cost (optional). Defaults follow OWASP interactive recommendations.
DMART_ARGON2_M_COST=19456
DMART_ARGON2_T_COST=3
DMART_ARGON2_P_COST=1

# Trust X-Forwarded-For only when running behind a reverse proxy that
# overwrites it (e.g. Caddy in docker-compose.prod.yml).
DMART_TRUST_PROXY=false

# Strict-Transport-Security header (only useful over HTTPS).
DMART_ENABLE_HSTS=true

# CORS allowed origins (comma-separated)
DMART_CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
