# =============================================================================
# dMart UCI Server - Environment Variables
# =============================================================================
# Copy this file to .env and adjust values for your environment

# Server
DMART_PORT=3000
DMART_HOST=0.0.0.0

# Database
DMART_DB_PATH=./data/dmart.db

# Frontend static files
DMART_DIST_PATH=./dist

# Cache (Valkey/Redis)
DMART_VALKEY_URL=redis://127.0.0.1:6379

# Logging
RUST_LOG=dmart_server=info,tower_http=info

# Security (REQUIRED — the server refuses to start until you replace these)
# Generate real random values BEFORE the first run:
#     openssl rand -hex 32      # for DMART_MASTER_KEY
#     openssl rand -hex 32      # for JWT_SECRET
# The placeholder values below are PUBLIC (committed to git) AND too short, so
# the server rejects them (fail-closed): a copied `.env.example` will never let
# weak/leaked secrets protect data. Replace them before the first run.
DMART_MASTER_KEY=CHANGE-ME-32c
JWT_SECRET=CHANGE-ME-JWT-32c
JWT_EXPIRY_HOURS=1

# Metrics token (optional). If set, `/obs/metrics` y `/obs/slo` exigen
# `Authorization: Bearer <token>`. Sin este valor los KPIs clínicos extendidos
# (`METRICS_EXTENDED`) permanecen deshabilitados.
#DMART_METRICS_TOKEN=CHANGE-ME-METRICS-SCRAPE-TOKEN

# Admin initial password (first run only). Leave empty to generate a random
# one that is printed once in the server logs.
DMART_ADMIN_PASSWORD=

# Argon2id cost (optional). Defaults follow OWASP interactive recommendations.
DMART_ARGON2_M_COST=19456
DMART_ARGON2_T_COST=3
DMART_ARGON2_P_COST=1

# Trust X-Forwarded-For only when running behind a reverse proxy that
# overwrites it (e.g. Caddy in docker-compose.prod.yml).
DMART_TRUST_PROXY=false

# IPs de proxy de confianza (comma-separated) para aceptar X-Forwarded-For.
# Con DMART_TRUST_PROXY=true y lista vacía solo se confía en loopback.
DMART_TRUSTED_PROXIES=

# Refresh-token cookie: `Secure` por defecto (solo HTTPS). Desactivar únicamente
# en desarrollo local sin HTTPS; nunca en producción.
#DMART_COOKIE_SECURE=false

# Strict-Transport-Security header (only useful over HTTPS).
DMART_ENABLE_HSTS=true

# CORS allowed origins (comma-separated)
DMART_CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
