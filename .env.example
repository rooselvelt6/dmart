# =============================================================================
# dMart UCI Server - Environment Variables
# =============================================================================
# Copy this file to .env and adjust values for your environment

# Server
DMART_PORT=3000
DMART_HOST=0.0.0.0

# Database
DMART_DB_PATH=./data/dmart.db

# Frontend static files
DMART_DIST_PATH=./dist

# Cache (Valkey/Redis)
DMART_VALKEY_URL=redis://127.0.0.1:6379

# Logging
RUST_LOG=dmart_server=info,tower_http=info

# Security (change in production!)
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRY_HOURS=1

# Admin initial password (first run only)
DMART_ADMIN_PASSWORD=admin123

# CORS allowed origins (comma-separated)
DMART_CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
