# =============================================================================
# dMart UCI Server - Environment Variables
# =============================================================================
# Copy this file to .env and adjust values for your environment

# Server
DMART_PORT=3000
DMART_HOST=0.0.0.0

# Database
DMART_DB_PATH=./data/dmart.db

# Frontend static files
DMART_DIST_PATH=./dist

# Cache (Valkey/Redis)
DMART_VALKEY_URL=redis://127.0.0.1:6379

# Logging
RUST_LOG=dmart_server=info,tower_http=info

# Security (REQUIRED — the server refuses to start until you replace these)
# Generate real random values BEFORE the first run:
#     openssl rand -hex 32      # for DMART_MASTER_KEY
#     openssl rand -hex 32      # for JWT_SECRET
# The placeholders below are PUBLIC (committed to git). The startup validation
# rejects them explicitly — not just for being short, but because they carry
# placeholder markers like `CHANGE-ME`. Replace them before the first run.
DMART_MASTER_KEY=
JWT_SECRET=
JWT_EXPIRY_HOURS=1

# HMAC key for the immutable audit chain (SPEC-049). Empty → derived from
# DMART_MASTER_KEY via HKDF-SHA256 with a separate domain label.
DMART_AUDIT_HMAC_KEY=

# ─── HL7/MLLP listener (bedside monitors) ─────────────────
# Disabled unless DMART_HL7_PORT is set.
#
# MLLP has no native authentication, so the boundary is enforced in
# `server_ingest::MllpSecurityConfig`:
#   DMART_MLLP_BIND                  → interface to listen on.
#                                     DEFAULT 127.0.0.1 (loopback only). Set the
#                                     VLAN interface explicitly to expose it.
#   DMART_MLLP_AUTH_SECRET           → shared secret. When set, the FIRST frame of
#                                     every connection must be a handshake:
#                                       <VT><MSH|^~\&|DMART-AUTH|<secret>|...><CR><FS><CR>
#                                     Connections without it are closed with an
#                                     `unauthorized` ACK. STRONGLY recommended.
#   DMART_MLLP_ALLOWED_SENDERS       → CSV allowlist of MSH.3 sending applications
#                                     allowed to write vitals after handshake.
#   DMART_MLLP_MAX_CONNECTIONS       → concurrent connections (default 64)
#   DMART_MLLP_MAX_CONNECTIONS_PER_IP→ concurrent connections per source IP (default 8)
#   DMART_MLLP_READ_TIMEOUT_SECS     → per-read deadline, anti slow-loris (default 30)
#   DMART_MLLP_WRITE_TIMEOUT_SECS    → ACK write deadline (default 10)
#
# ── mTLS (REQUERIDO en producción: sin esto el tráfico viaja en claro) ──────
# El listener acepta TLS 1.3 con AES-256-GCM y EXIGE certificado de cliente
# firmado por la CA propia de monitores. La identidad se fija por el SHA-256 del
# certificado (pinning) y ese pin determina el MSH.3 que la conexión puede
# declarar: un monitor no puede hacerse pasar por otro.
#DMART_HL7_PORT=2575
#DMART_MLLP_BIND=10.0.1.20:2575
#DMART_MLLP_CERT_FILE=/etc/dmart/mllp/server.pem
#DMART_MLLP_KEY_FILE=/etc/dmart/mllp/server.key
#DMART_MLLP_CA_FILE=/etc/dmart/mllp/monitors-ca.pem
#DMART_MLLP_CLIENT_IDS=<sha256-cert-monitor-bed-1>=monitor-bed-1,<sha256-cert-bed-2>=monitor-bed-2
#
# Capa 2 opcional (se puede usar SIN mTLS en loopback/VLAN de pruebas):
#DMART_MLLP_AUTH_SECRET=
#DMART_MLLP_ALLOWED_SENDERS=monitor-bed-1,monitor-bed-2

# Metrics token (REQUIRED to expose /obs/metrics and /obs/slo). Without it those
# endpoints return 401 (fail-closed) instead of serving clinical/ML KPIs publicly.
#     openssl rand -hex 32
#DMART_METRICS_TOKEN=

# Admin initial password (first run only). Leave empty to generate a random
# one that is printed once in the server logs.
DMART_ADMIN_PASSWORD=

# Argon2id cost (optional). Defaults follow OWASP interactive recommendations.
DMART_ARGON2_M_COST=19456
DMART_ARGON2_T_COST=3
DMART_ARGON2_P_COST=1

# Trust X-Forwarded-For only when running behind a reverse proxy that
# overwrites it (e.g. Caddy in docker-compose.prod.yml).
DMART_TRUST_PROXY=false

# IPs de proxy de confianza (comma-separated) para aceptar X-Forwarded-For.
# Con DMART_TRUST_PROXY=true y lista vacía solo se confía en loopback.
DMART_TRUSTED_PROXIES=

# Refresh-token cookie: `Secure` por defecto (solo HTTPS). Desactivar únicamente
# en desarrollo local sin HTTPS; nunca en producción.
#DMART_COOKIE_SECURE=false

# Strict-Transport-Security header (only useful over HTTPS).
DMART_ENABLE_HSTS=true

# CORS allowed origins (comma-separated)
DMART_CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# ─── Rate Limiting & Login Throttle (desarrollo) ─────────────────
# Desactivar rate limiter global (100 rpm por defecto)
# DMART_DISABLE_RATE_LIMIT=true
# DMART_RATE_LIMIT_RPM=1000
# DMART_RATE_LIMIT_WINDOW_SECS=60
#
# Desactivar login throttle (5 intentos / 5 min por defecto)
# DMART_DISABLE_LOGIN_THROTTLE=true
# DMART_LOGIN_THROTTLE_MAX_ATTEMPTS=5
# DMART_LOGIN_THROTTLE_LOCKOUT_SECS=300
#
# Desactivar MFA throttle (3 intentos / 5 min por defecto)
# DMART_DISABLE_MFA_THROTTLE=true
# DMART_MFA_THROTTLE_MAX_ATTEMPTS=3
# DMART_MFA_THROTTLE_LOCKOUT_SECS=300
