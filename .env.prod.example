# Producción/Staging (SPEC-012) — copia a .env.prod y rellena.
# docker compose -f docker-compose.prod.yml  lee este archivo si está como .env.prod

# OBLIGATORIA: 64 hex chars (256 bits). Vacía a propósito — el servidor rechaza
# arrancar (fail-closed) con valores placeholder, de modo que un
# `cp .env.prod.example .env.prod` sin editar nunca exponga datos con una clave
# pública. Se usa para cifrar datos sensibles en reposo y para el HMAC de la
# cadena de auditoría WORM.
#   Generar: openssl rand -hex 32
DMART_MASTER_KEY=

# OBLIGATORIA: 64 hex chars (256 bits). Sin ella el servidor NO arranca
# (fail-closed): un secreto JWT predecible permite forjar access tokens.
#   Generar: openssl rand -hex 32
JWT_SECRET=

# HMAC de la cadena de auditoría. Si se deja vacío se deriva por HKDF-SHA256
# desde DMART_MASTER_KEY con dominio separado ("dmart-audit-chain-v1").
DMART_AUDIT_HMAC_KEY=

# Contraseña inicial del usuario admin (solo se aplica en el primer seed).
DMART_ADMIN_PASSWORD=

# Costes Argon2id (puerto con seguridad razonable en hardware clínico).
DMART_ARGON2_M_COST=19456
DMART_ARGON2_T_COST=3
DMART_ARGON2_P_COST=1

# Reverse proxy.
#    ":80"                            → HTTP en LAN (piloto sin dominio)
#    "https://dmart.hospital.example" → auto-TLS Let's Encrypt
SITE_ADDRESS=:80

# Encabezados HSTS solo tienen sentido sobre HTTPS; déjalo false en HTTP.
DMART_ENABLE_HSTS=false

# Zona horaria del contenedor (logs).
TZ=America/Havana

# ─── Alerting (SPEC-008) ───────────────────────────────────
# Webhook genérico (Slack, PagerDuty, Opsgenie, custom)
ALERT_WEBHOOK_URL=
# Webhook para alertas críticas (puede ser distinto canal)
ALERT_WEBHOOK_CRITICAL_URL=
# Webhook específico HL7 (equipo clínico on-call)
ALERT_WEBHOOK_HL7_URL=
# Webhook para operaciones/backup
ALERT_WEBHOOK_OPS_URL=

# Email (requiere SMTP configurado)
ALERT_EMAIL_SMTP_HOST=smtp.example.com:587
ALERT_EMAIL_SMTP_USER=
ALERT_EMAIL_SMTP_PASS=
ALERT_EMAIL_FROM=alerts@dmart.local
ALERT_EMAIL_TO=ops@dmart.local
ALERT_EMAIL_CRITICAL_TO=oncall@dmart.local
ALERT_EMAIL_HL7_TO=clinical-oncall@dmart.local
ALERT_EMAIL_OPS_TO=ops@dmart.local

# ─── Backup (SPEC-009) ─────────────────────────────────────
# Ruta de almacenamiento de backups (volumen dmart-backups)
BACKUP_STORAGE_PATH=/backups
# Host/puerto Valkey para backup (desde contenedor dmart-server)
DMART_VALKEY_HOST=valkey
DMART_VALKEY_PORT=6379

# ─── Entorno de ejecución ───────────────────────────────────
# `production` activa el arranque fail-closed del listener MLLP: sin mTLS el
# proceso aborta en vez de exponer PHI en claro.
DMART_ENV=production

# ─── HL7/MLLP bedside (SPEC-052 / auditoría H3) ──────────
# MLLP es texto plano sobre TCP. En producción el listener NO arranca sin mTLS
# (DMART_ENV=production + sin mTLS => arranque abortado), de modo que ni el
# secreto de autenticación ni las constantes vitales viajan en claro.
#   DMART_MLLP_BIND                  → interfaz. Default 127.0.0.1 (loopback).
#   DMART_MLLP_CERT_FILE/KEY_FILE    → certificado y clave del servidor.
#   DMART_MLLP_CA_FILE               → CA que firma los certificados de monitor.
#   DMART_MLLP_CLIENT_IDS            → pins: <sha256-cert>=<MSH.3>,CSV. La
#                                     identidad del transporte es el certificado,
#                                     así que un monitor no puede declarar el
#                                     MSH.3 de otro.
# TLS 1.3 + AES-256-GCM exclusivamente; el certificado de cliente es obligatorio.
DMART_HL7_PORT=2575
DMART_MLLP_BIND=127.0.0.1:2575
DMART_MLLP_CERT_FILE=
DMART_MLLP_KEY_FILE=
DMART_MLLP_CA_FILE=
DMART_MLLP_CLIENT_IDS=
DMART_MLLP_MAX_CONNECTIONS=64
DMART_MLLP_MAX_CONNECTIONS_PER_IP=8
DMART_MLLP_READ_TIMEOUT_SECS=30
DMART_MLLP_WRITE_TIMEOUT_SECS=10
# Capa 2 adicional (opcional con mTLS). Se guarda en memoria Zeroizing.
DMART_MLLP_AUTH_SECRET=
