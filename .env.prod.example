# Producción/Staging (SPEC-012) — copia a .env.prod y rellena.
# docker compose -f docker-compose.prod.yml  lee este archivo si está como .env.prod

# OBLIGATORIA: 64 hex chars mínimo (128 bits reales de entropía).
# Se usa para cifrar la DB en reposo (SurrealKV) y firmar JWT.
#   Generar: openssl rand -hex 32
DMART_MASTER_KEY=CHANGE_ME_64hex_openssl_rand_hex_32

# Contraseña inicial del usuario admin (solo se aplica en el primer seed).
DMART_ADMIN_PASSWORD=

# Costes Argon2id (puerto con seguridad razonable en hardware clínico).
DMART_ARGON2_M_COST=19456
DMART_ARGON2_T_COST=3
DMART_ARGON2_P_COST=1

# Reverse proxy.
#    ":80"                            → HTTP en LAN (piloto sin dominio)
#    "https://dmart.hospital.example" → auto-TLS Let's Encrypt
SITE_ADDRESS=:80

# Encabezados HSTS solo tienen sentido sobre HTTPS; déjalo false en HTTP.
DMART_ENABLE_HSTS=false

# Zona horaria del contenedor (logs).
TZ=America/Havana

# ─── Alerting (SPEC-008) ───────────────────────────────────
# Webhook genérico (Slack, PagerDuty, Opsgenie, custom)
ALERT_WEBHOOK_URL=
# Webhook para alertas críticas (puede ser distinto canal)
ALERT_WEBHOOK_CRITICAL_URL=
# Webhook específico HL7 (equipo clínico on-call)
ALERT_WEBHOOK_HL7_URL=
# Webhook para operaciones/backup
ALERT_WEBHOOK_OPS_URL=

# Email (requiere SMTP configurado)
ALERT_EMAIL_SMTP_HOST=smtp.example.com:587
ALERT_EMAIL_SMTP_USER=
ALERT_EMAIL_SMTP_PASS=
ALERT_EMAIL_FROM=alerts@dmart.local
ALERT_EMAIL_TO=ops@dmart.local
ALERT_EMAIL_CRITICAL_TO=oncall@dmart.local
ALERT_EMAIL_HL7_TO=clinical-oncall@dmart.local
ALERT_EMAIL_OPS_TO=ops@dmart.local

# ─── Backup (SPEC-009) ─────────────────────────────────────
# Ruta de almacenamiento de backups (volumen dmart-backups)
BACKUP_STORAGE_PATH=/backups
# Host/puerto Valkey para backup (desde contenedor dmart-server)
DMART_VALKEY_HOST=valkey
DMART_VALKEY_PORT=6379